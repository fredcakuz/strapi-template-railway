{
  "kind": "collectionType",
  "collectionName": "campagne",
  "info": {
    "singularName": "campagna",
    "pluralName": "campagne",
    "displayName": "Campagna ADV"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "cliente": { "type": "string", "required": true },
    "titolo": { "type": "string" },
    "immagine_desktop": { "type": "media", "multiple": false, "allowedTypes": ["images"], "required": true },
    "immagine_mobile": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "alt": { "type": "string", "required": true },
    "link": { "type": "string", "required": true },
    "inizio": { "type": "date", "required": true },
    "fine": { "type": "date", "required": true },
    "peso": { "type": "integer", "default": 1, "min": 1, "max": 5 },
    "posizioni": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::posizione.posizione",
      "inversedBy": "campagne"
    }
  }
}
