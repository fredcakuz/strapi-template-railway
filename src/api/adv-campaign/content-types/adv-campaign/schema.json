{
  "kind": "collectionType",
  "collectionName": "adv_campaigns",
  "info": {
    "singularName": "adv-campaign",
    "pluralName": "adv-campaigns",
    "displayName": "Adv Campaign"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "client": { "type": "string", "required": true },
    "title": { "type": "string" },
    "desktop_image": { "type": "media", "multiple": false, "allowedTypes": ["images"], "required": true },
    "mobile_image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "alt": { "type": "string", "required": true },
    "link": { "type": "string", "required": true },
    "start_date": { "type": "date", "required": true },
    "end_date": { "type": "date", "required": true },
    "weight": { "type": "integer", "default": 1, "min": 1, "max": 5 },
    "positions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::adv-position.adv-position",
      "inversedBy": "campaigns"
    }
  }
}
