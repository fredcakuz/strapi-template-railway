{
  "kind": "collectionType",
  "collectionName": "posizioni",
  "info": {
    "singularName": "posizione",
    "pluralName": "posizioni",
    "displayName": "Posizione ADV"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "codice": {
      "type": "enumeration",
      "enum": ["home_1", "home_2", "lista_1", "lista_2", "articolo_1", "articolo_2"],
      "required": true,
      "unique": true
    },
    "descrizione": { "type": "string" },
    "attiva": { "type": "boolean", "default": true },
    "modo": {
      "type": "enumeration",
      "enum": ["peso", "giorno", "sequenza"],
      "default": "giorno",
      "required": true
    },
    "campagne": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::campagna.campagna",
      "mappedBy": "posizioni"
    }
  }
}
